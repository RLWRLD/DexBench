#usda 1.0
(
    defaultPrim = "World"
    doc = """DexBench E3 제조 조립 라인 — 정본 씬 (fixture 슬롯 + 구조물 + anchor 만).
tools\\usd\\u01_assemble.py --env e3 가 생성한다. 손으로 고쳤다면 다음 실행에 덮인다.
소품은 scene/items_default.usda, 조명은 scene/lighting.usda,
로봇·카메라는 scene/assembly_line_e3_viz.usda 몫이다 (플랜 §3).
단위 m, Z-up. 좌표 원점 = 룸 남서 바닥 모서리 (룸 5.0 × 4.0 × H3.5, 밀폐 셀)."""
    metersPerUnit = 1
    upAxis = "Z"
)

def "World" (
    prepend references = @../scene.usdz@</__EmbeddedSceneLayers/layer_95f69fc9a1a079745dd2/World>
)
{
    over "FixtureSlots"
    {
        over "Slot_Conveyor"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/conveyor_module/usd/conveyor_module.usda@
            )
            {
            }
        }

