#usda 1.0
(
    defaultPrim = "World"
    doc = """E4 banquet hall, default composition: r01's scene with the clearing-station table removed and the serving cart duplicated.
Slot_StackDestination at (1.48, 1.768, 0) reuses the serving cart payload; H1 stacks dishes onto it.
Slot_Clearing is removed. Other fixture slots, anchors, background and background collision are r01's.
Units are metres, Z-up.
Robot and dish reset poses belong to the task, not this scene layer."""
    metersPerUnit = 1
    upAxis = "Z"
)

def "World" (
    prepend references = @../scene.usdz@</__EmbeddedSceneLayers/layer_c74b3e9e6e21cfd7cd6f/World>
)
{
    over "FixtureSlots"
    {
        over "Slot_RoundTable"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/round_table_fc/usd/round_table_fc.usd@
            )
            {
            }
        }

        over "Slot_Serving"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/serving_station_fc/usd/serving_station_fc.usd@
            )
            {
            }
        }

        over "Slot_StackDestination"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/serving_station_fc/usd/serving_station_fc.usd@
            )
            {
            }
        }

        over "Slot_UtensilStand"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/utensil_stand_fc/usd/utensil_stand_fc.usd@
            )
            {
            }
        }

        over "Slot_UtensilBin"
        {
            over "Asset" (
                prepend payload = @../../../../../object_library/utensil_bin_fc/usd/utensil_bin_fc.usd@
            )
            {
            }
        }
    }
}

