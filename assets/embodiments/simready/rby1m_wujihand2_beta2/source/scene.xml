<mujoco model="rby1m_wujihand2_beta2 scene">
  <!-- viewer/sanity wrapper — the sim stack consumes rby1m_wujihand2_beta2.xml directly. Floor contact
       params come from the vendor rby1 scene (condim=1, low friction: mecanum-safe). -->
  <include file="rby1m_wujihand2_beta2.xml"/>

  <statistic center="0.010 0.000 0.618" extent="3.10"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.25" type="plane" material="groundplane" condim="1" solimp="0.95 0.99 0.001 0.5 2" friction="0.05 0.001 0.05"/>
  </worldbody>
</mujoco>
