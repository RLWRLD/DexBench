    def Scope "Control" (
        customData = {
            dictionary conveyor = {
                string control_api = "dexbench.conveyor_control/2"
            }
        }
        doc = "컨베이어 제어(dexbench.conveyor_control/2 · 계획 §5 · D-73). Play 뒤 이 프림의 입력 3 개만 바꾼다: run(bool · 기본 false) · hb2_speed_mps · fb1_speed_mps(float m/s · 비음수 · 유한). 유효 속도 = run 이고 입력이 유효하면 설정 속도, 아니면 0 (개별 0 = 그 벨트 정지 · run=false = 양쪽 정지 · 음수·NaN·∞ = 그 벨트 0 + inputs_valid=false). 정지는 실제 표면 속도 0 을 쓴다. 진단 출력 hb2/fb1_effective_mps · inputs_valid 는 그래프가 물리 스텝마다 쓴다(읽기 전용). 구 API 1 의 mode · hb2_request 는 없다."
    )
    {
        custom float conveyor:control:fb1_effective_mps = 0 (
            customData = {
                dictionary conveyor = {
                    string direction = "out"
                }
            }
            displayGroup = "Conveyor Diagnostics (read-only)"
            doc = "진단(읽기 전용) — 물리 스텝마다 그래프가 쓰는 FB1 유효 속도."
        )
        custom float conveyor:control:fb1_speed_mps = 0.2 (
            customData = {
                dictionary conveyor = {
                    string direction = "in"
                }
            }
            displayGroup = "Conveyor Control"
            doc = "FB1(배출) 벨트 속도 m/s · 비음수·유한. 0 = FB1 정지. 음수·NaN·∞ = 그 벨트 0 + inputs_valid=false."
        )
        custom float conveyor:control:hb2_effective_mps = 0 (
            customData = {
                dictionary conveyor = {
                    string direction = "out"
                }
            }
            displayGroup = "Conveyor Diagnostics (read-only)"
            doc = "진단(읽기 전용) — 물리 스텝마다 그래프가 쓰는 HB2 유효 속도."
        )
        custom float conveyor:control:hb2_speed_mps = 0.2 (
            customData = {
                dictionary conveyor = {
                    string direction = "in"
                }
            }
            displayGroup = "Conveyor Control"
            doc = "HB2(투입) 벨트 속도 m/s · 비음수·유한. 0 = HB2 정지. 음수·NaN·∞ = 그 벨트 0 + inputs_valid=false."
        )
        custom bool conveyor:control:inputs_valid = 1 (
            customData = {
                dictionary conveyor = {
                    string direction = "out"
                }
            }
            displayGroup = "Conveyor Diagnostics (read-only)"
            doc = "진단(읽기 전용) — 두 속도 입력이 모두 비음수·유한이면 true."
        )
        custom bool conveyor:control:run = 0 (
            customData = {
                dictionary conveyor = {
                    string direction = "in"
                }
            }
            displayGroup = "Conveyor Control"
            doc = "전체 운전. false = 설정 속도와 관계없이 두 벨트 실제 표면 속도 0(배포 기본 false)."
        )

        def OmniGraph "ControlGraph"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "StageWithoutHistory"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageOnDemand"

            def OmniGraphNode "OnStep"
            {
                token node:type = "isaacsim.core.nodes.OnPhysicsStep"
                int node:typeVersion = 1
                custom double outputs:deltaSimulationTime
                custom double outputs:deltaSystemTime
                custom uint outputs:step (
                    customData = {
                        bool isExecution = 1
                    }
                )
            }

            def OmniGraphNode "read_run"
            {
                custom token inputs:name = "conveyor:control:run"
                custom rel inputs:prim = </LogisticsConveyor/Control> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:usePath = 0
                token node:type = "omni.graph.nodes.ReadPrimAttribute"
                int node:typeVersion = 3
                custom bool outputs:value
            }

            def OmniGraphNode "read_hb2_speed"
            {
                custom token inputs:name = "conveyor:control:hb2_speed_mps"
                custom rel inputs:prim = </LogisticsConveyor/Control> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:usePath = 0
                token node:type = "omni.graph.nodes.ReadPrimAttribute"
                int node:typeVersion = 3
                custom float outputs:value
            }

            def OmniGraphNode "read_fb1_speed"
            {
                custom token inputs:name = "conveyor:control:fb1_speed_mps"
                custom rel inputs:prim = </LogisticsConveyor/Control> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:usePath = 0
                token node:type = "omni.graph.nodes.ReadPrimAttribute"
                int node:typeVersion = 3
                custom float outputs:value
            }

            def OmniGraphNode "f_zero"
            {
                custom float inputs:value = 0
                token node:type = "omni.graph.nodes.ConstantFloat"
                int node:typeVersion = 1
            }

            def OmniGraphNode "f_max"
            {
                custom float inputs:value = 3.4028235e38
                token node:type = "omni.graph.nodes.ConstantFloat"
                int node:typeVersion = 1
            }

            def OmniGraphNode "hb2_speed_ge0"
            {
                custom float inputs:a
                prepend float inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/read_hb2_speed.outputs:value>
                custom float inputs:b
                prepend float inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/f_zero.inputs:value>
                custom token inputs:operation = ">="
                token node:type = "omni.graph.nodes.Compare"
                int node:typeVersion = 1
                custom bool outputs:result
            }

            def OmniGraphNode "hb2_speed_finite"
            {
                custom float inputs:a
                prepend float inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/read_hb2_speed.outputs:value>
                custom float inputs:b
                prepend float inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/f_max.inputs:value>
                custom token inputs:operation = "<="
                token node:type = "omni.graph.nodes.Compare"
                int node:typeVersion = 1
                custom bool outputs:result
            }

            def OmniGraphNode "hb2_speed_valid"
            {
                custom bool inputs:a
                prepend bool inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/hb2_speed_ge0.outputs:result>
                custom bool inputs:b
                prepend bool inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/hb2_speed_finite.outputs:result>
                token node:type = "omni.graph.nodes.BooleanAnd"
                int node:typeVersion = 2
                custom bool outputs:result
            }

            def OmniGraphNode "hb2_go"
            {
                custom bool inputs:a
                prepend bool inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/read_run.outputs:value>
                custom bool inputs:b
                prepend bool inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/hb2_speed_valid.outputs:result>
                token node:type = "omni.graph.nodes.BooleanAnd"
                int node:typeVersion = 2
                custom bool outputs:result
            }

            def OmniGraphNode "hb2_effective"
            {
                custom bool inputs:condition
                prepend bool inputs:condition.connect = </LogisticsConveyor/Control/ControlGraph/hb2_go.outputs:result>
                custom float inputs:ifFalse
                prepend float inputs:ifFalse.connect = </LogisticsConveyor/Control/ControlGraph/f_zero.inputs:value>
                custom float inputs:ifTrue
                prepend float inputs:ifTrue.connect = </LogisticsConveyor/Control/ControlGraph/read_hb2_speed.outputs:value>
                token node:type = "omni.graph.nodes.SelectIf"
                int node:typeVersion = 1
                custom float outputs:result
            }

            def OmniGraphNode "fb1_speed_ge0"
            {
                custom float inputs:a
                prepend float inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/read_fb1_speed.outputs:value>
                custom float inputs:b
                prepend float inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/f_zero.inputs:value>
                custom token inputs:operation = ">="
                token node:type = "omni.graph.nodes.Compare"
                int node:typeVersion = 1
                custom bool outputs:result
            }

            def OmniGraphNode "fb1_speed_finite"
            {
                custom float inputs:a
                prepend float inputs:a.connect = </LogisticsConveyor/Control/ControlGraph/read_fb1_speed.outputs:value>
                custom float inputs:b
                prepend float inputs:b.connect = </LogisticsConveyor/Control/ControlGraph/f_max.inputs:value>
                custom token inputs:operation = "<="
