        }

        over "HB2_Belt"
        {
            def Xform "TransportBody" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                doc = "HB2 반송 강체(키네마틱). 충돌 = 상면 평탄 구간 박스(드럼 축 74.5~1954.5 mm · 상면 812 mm). 표면 속도는 Control/ControlGraph 의 IsaacConveyor 노드가 쓴다(+X 바디 로컬 · Stop/열기 때 ResetGraph 가 0). 직접 쓰지 말 것."
            )
            {
                bool physics:kinematicEnabled = 1

                def Cube "TopRun" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </LogisticsConveyor/PhysicsMaterials/PM_belt> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token purpose = "guide"
                    double size = 1
                    float3 xformOp:scale = (1.88, 0.75, 0.02)
                    double3 xformOp:translate = (1.0144999795593321, 0, 0.802)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            over "HB2_Belt" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </LogisticsConveyor/Looks/Belt_HB2>
            }
        }

        over "FB1_Belt"
        {
            def Xform "TransportBody" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                doc = "FB1 반송 강체(키네마틱). 충돌 = 상면 평탄 구간 박스(드럼 축 2316.5~3192.5 mm · 상면 800 mm). 표면 속도는 Control/ControlGraph 의 IsaacConveyor 노드가 쓴다(+X 바디 로컬 · Stop/열기 때 ResetGraph 가 0). 직접 쓰지 말 것."
