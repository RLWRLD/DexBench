    defaultPrim = "LogisticsConveyor"
    doc = "컨베이어 공용 모듈(CV-M02 · 제어 API 2 = REV-M02) — tools/usd/conveyor_build.py 생성물. 직접 고치지 말 것."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LogisticsConveyor" (
    doc = "DexBench E2·E3 공용 컨베이어 (CV-M02). 좌표계 EQ(D-01): 원점 = 바닥·HB2 프레임 투입단 끝면·폭 중심, +X 반송, +Y 전면(로봇·제어함 쪽), Z-up, m. 형상 = ./_build/logistics_conveyor_geom.usdc(reference). 제어 = /LogisticsConveyor/Control 의 입력 3 개 conveyor:control:{run, hb2_speed_mps, fb1_speed_mps}(API 2 · Isaac + 확장 isaacsim.asset.gen.conveyor 필요 — 꺼져 있으면 벨트가 오류 없이 안 돈다). 물성은 configs/logistics_conveyor/physics.json 의 시뮬레이션 초기값(실측 아님)."
    kind = "component"
    prepend references = @./geometry/logistics_conveyor_geom.usdc@</LogisticsConveyor>
    variants = {
        string Newton = "Disabled"
        string PhysX = "Disabled"
    }
    append variantSets = ["Newton", "PhysX"]
)
{
    def Scope "PhysicsMaterials"
    {
        def Material "PM_belt" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
            doc = "physics.json materials.belt — 시뮬레이션 초기값(실측 아님)"
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }

        def Material "PM_plate" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
            doc = "physics.json materials.plate — 시뮬레이션 초기값(실측 아님)"
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "PM_roller" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
            doc = "physics.json materials.roller — 시뮬레이션 초기값(실측 아님)"
        )
        {
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.75
        }

        def Material "PM_frame" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
            doc = "physics.json materials.frame — 시뮬레이션 초기값(실측 아님)"
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Scope "Looks"
    {
        def Material "Belt_HB2" (
            doc = "HB2 벨트 재질(벨트별 분리 — UV 상태 섞임 방지). UV U = 순환 호 길이(m) · scale (1/0.3, 폭/0.3) · translation.x = −∫유효속도 dt / 주기 (ControlGraph 가 적분) · 기본색·거칠기·노멀이 같은 UV 로 움직인다."
        )
        {
            token outputs:surface.connect = </LogisticsConveyor/Looks/Belt_HB2/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </LogisticsConveyor/Looks/Belt_HB2/BaseTex.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </LogisticsConveyor/Looks/Belt_HB2/NormalTex.outputs:rgb>
                float inputs:roughness.connect = </LogisticsConveyor/Looks/Belt_HB2/RoughTex.outputs:r>
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }

            def Shader "STReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "UVAnim"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </LogisticsConveyor/Looks/Belt_HB2/STReader.outputs:result>
                float2 inputs:scale = (3.3333333, 2.5)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "BaseTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/belt_black_base.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_HB2/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/belt_black_rough.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_HB2/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.6, -0.6, -1, 0)
                asset inputs:file = @./textures/src_leather_white_normal.png@
                float4 inputs:scale = (1.2, 1.2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_HB2/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Belt_FB1" (
            doc = "FB1 벨트 재질(벨트별 분리 — UV 상태 섞임 방지). UV U = 순환 호 길이(m) · scale (1/0.3, 폭/0.3) · translation.x = −∫유효속도 dt / 주기 (ControlGraph 가 적분) · 기본색·거칠기·노멀이 같은 UV 로 움직인다."
        )
        {
            token outputs:surface.connect = </LogisticsConveyor/Looks/Belt_FB1/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </LogisticsConveyor/Looks/Belt_FB1/BaseTex.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </LogisticsConveyor/Looks/Belt_FB1/NormalTex.outputs:rgb>
                float inputs:roughness.connect = </LogisticsConveyor/Looks/Belt_FB1/RoughTex.outputs:r>
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }

            def Shader "STReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "UVAnim"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </LogisticsConveyor/Looks/Belt_FB1/STReader.outputs:result>
                float2 inputs:scale = (3.3333333, 2.5)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "BaseTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/belt_black_base.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_FB1/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/belt_black_rough.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_FB1/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.6, -0.6, -1, 0)
                asset inputs:file = @./textures/src_leather_white_normal.png@
                float4 inputs:scale = (1.2, 1.2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/Looks/Belt_FB1/UVAnim.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    over "Belts"
    {
        over "HB2_EdgeCover_B"
        {
            over "HB2_EdgeCover_B" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </LogisticsConveyor/PhysicsMaterials/PM_frame> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token physics:approximation = "convexHull"
            }
        }

        over "HB2_EdgeCover_F"
