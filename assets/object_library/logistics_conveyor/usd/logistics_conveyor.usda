    over "_materials"
    {
        over "ButtonGreen" (
            doc = "외관 button_green(looks.json · 타일 2.125 m · 가공 — tools/conveyor_looks.py)"
        )
        {
            def Shader "STReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tile"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </LogisticsConveyor/_materials/ButtonGreen/STReader.outputs:result>
                float2 inputs:scale = (0.47058824, 0.47058824)
                float2 outputs:result
            }

            def Shader "BaseTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/button_green_base.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </LogisticsConveyor/_materials/ButtonGreen/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/button_green_rough.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/_materials/ButtonGreen/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.1, -0.1, -1, 0)
                asset inputs:file = @./textures/src_blue_metal_plate_normal.png@
                float4 inputs:scale = (0.2, 0.2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </LogisticsConveyor/_materials/ButtonGreen/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            over "Principled_BSDF"
            {
                color3f inputs:diffuseColor.connect = </LogisticsConveyor/_materials/ButtonGreen/BaseTex.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </LogisticsConveyor/_materials/ButtonGreen/NormalTex.outputs:rgb>
                float inputs:roughness.connect = </LogisticsConveyor/_materials/ButtonGreen/RoughTex.outputs:r>
                int inputs:useSpecularWorkflow = 0
            }
