#usda 1.0
(
    customLayerData = {
        dictionary SimReady_Metadata = {
            float3 asset_extents = (0.48148277, 0.229884, 0.018128)
            string asset_license = "CC-BY-4.0"
            string asset_name = "cutlery_set"
            string asset_type = "prop"
            string author = "ForgeCAD"
            string category = "tableware"
            double mass = 0.2884211726486683
            string qcode = "Q81944"
            int rigid_body_count = 5
            string source = "ForgeCAD"
            string source_file = "main.usda"
            string usd_date_generated = "2026-10-17"
        }
        string asset_name = "cutlery_set"
        string asset_type = "prop"
        string source_file = "main.usda"
        string usd_date_generated = "2026-10-17"
    }
    defaultPrim = "Model"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Model" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:wikidata_qcode"]
    prepend references = @./forgecad/geometry.usda@</Model>
    variants = {
        string finish = "polished_steel"
        string physics = "physics"
    }
    prepend variantSets = ["physics", "finish"]
)
{
    token[] semantics:labels:class = ["cutlery"]
    token[] semantics:labels:wikidata_qcode = ["Q81944"]

    def Scope "Materials"
    {
        def Material "PolishedSteel" (
            prepend apiSchemas = ["SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </Model/Materials/PolishedSteel/Surface.outputs:surface>
            token[] semantics:labels:material = ["metal"]

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.575)
                float inputs:metallic = 1
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "SatinSteel" (
            prepend apiSchemas = ["SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </Model/Materials/SatinSteel/Surface.outputs:surface>
            token[] semantics:labels:material = ["metal"]

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tile"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Model/Materials/SatinSteel/St.outputs:result>
                float2 inputs:scale = (16.667, 16.667)
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/brushed-cutlery-steel.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Model/Materials/SatinSteel/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Model/Materials/SatinSteel/Albedo.outputs:rgb>
                float inputs:metallic = 1
                float inputs:roughness = 0.26
                token outputs:surface
            }
        }

        def Material "BrushedSteel" (
            prepend apiSchemas = ["SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </Model/Materials/BrushedSteel/Surface.outputs:surface>
            token[] semantics:labels:material = ["metal"]

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tile"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Model/Materials/BrushedSteel/St.outputs:result>
                float2 inputs:scale = (16.667, 16.667)
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/brushed-cutlery-steel.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Model/Materials/BrushedSteel/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Model/Materials/BrushedSteel/Albedo.outputs:rgb>
                float inputs:metallic = 1
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "MatteBlack" (
            prepend apiSchemas = ["SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </Model/Materials/MatteBlack/Surface.outputs:surface>
            token[] semantics:labels:material = ["plastic"]

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.019, 0.019, 0.021)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "BrushedGold" (
            prepend apiSchemas = ["SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </Model/Materials/BrushedGold/Surface.outputs:surface>
            token[] semantics:labels:material = ["metal"]

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tile"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Model/Materials/BrushedGold/St.outputs:result>
                float2 inputs:scale = (16.667, 16.667)
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./assets/brushed-cutlery-gold.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Model/Materials/BrushedGold/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Model/Materials/BrushedGold/Albedo.outputs:rgb>
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }
    variantSet "finish" = {
        "brushed_gold" {
            over "Geometry"
            {
                over "Dessert_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedGold>
                }

                over "Table_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedGold>
                }

                over "Teaspoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedGold>
                }

                over "Tablespoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedGold>
                }

                over "Table_knife"
                {
                    over "Handle" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/BrushedGold>
                    }

                    over "Blade" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/BrushedGold>
                    }
                }
            }

        }
        "brushed_steel" {
            over "Geometry"
            {
                over "Dessert_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedSteel>
                }

                over "Table_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedSteel>
                }

                over "Teaspoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedSteel>
                }

                over "Tablespoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/BrushedSteel>
                }

                over "Table_knife"
                {
                    over "Handle" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/BrushedSteel>
                    }

                    over "Blade" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/BrushedSteel>
                    }
                }
            }

        }
        "matte_black" {
            over "Geometry"
            {
                over "Dessert_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/MatteBlack>
                }

                over "Table_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/MatteBlack>
                }

                over "Teaspoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/MatteBlack>
                }

                over "Tablespoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/MatteBlack>
                }

                over "Table_knife"
                {
                    over "Handle" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/MatteBlack>
                    }

                    over "Blade" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/MatteBlack>
                    }
                }
            }

        }
        "polished_steel" {
            over "Geometry"
            {
                over "Dessert_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/PolishedSteel>
                }

                over "Table_fork" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/PolishedSteel>
                }

                over "Teaspoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/PolishedSteel>
                }

                over "Tablespoon" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Model/Materials/PolishedSteel>
                }

                over "Table_knife"
                {
                    over "Handle" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/PolishedSteel>
                    }

                    over "Blade" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </Model/Materials/SatinSteel>
                    }
                }
            }

        }
    }
    variantSet "physics" = {
        "none" {

        }
        "physics" (
            prepend references = @./forgecad/physics.usda@</Model>
        ) {

        }
    }
}

