#usda 1.0
(
    customLayerData = {
        dictionary SimReady_Metadata = {
            dictionary Variants = {
                dictionary Physics = {
                    dictionary Newton = {
                        string activateOption = "Enabled"
                        string prim = "/Conveyor"
                        string variantSetName = "Newton"
                    }
                    dictionary PhysX = {
                        string activateOption = "Enabled"
                        string prim = "/Conveyor"
                        string variantSetName = "PhysX"
                    }
                }
            }
            string source_delivery = "deliveries/psl/e3_manufacturing/260827"
            string source_generated = "260826"
            string version = "1.0.0"
        }
        string asset_name = "conveyor_module"
        string asset_type = "fixture"
        string source_file = "deliveries/psl/e3_manufacturing/260827"
        string usd_date_generated = "2026-09-14"
    }
    defaultPrim = "Conveyor"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Conveyor" (
    "DexBench E2/E3 공유 컨베이어 모듈 (자작 — FCL-M1, G2·G3). 반송 방향 +X, 피벗=바닥면 중심, 벨트 상면 z=0.750 m, 반송면 폭 0.80 m, 총 길이 4.0 m, 외곽 폭 1.046 m(대칭). 공개 계약면 = ConveyorBeltGraph.graph:variable:Velocity (float, m/s, 0~0.6). 지오메트리 = ./conveyor_mesh.usdc (blend `conveyor_fc` 스테이징을 c09 가 익스포트 — 치수 정본 fixture_spec_e2 E-D11). NVIDIA/Isaac 어셋 참조 0 (G2)."
    kind = "component"
    variants = {
        string Newton = "Disabled"
        string PhysX = "Disabled"
    }
    append variantSets = ["Newton", "PhysX"]
)
{
    def Xform "Mesh" (
        prepend references = @./deps/conveyor_mesh/conveyor_mesh.usd@
    )
    {
        over "Geom"
        {
            over "conveyor_fc"
            {
                over "ConvFC_Belt" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    bool physics:kinematicEnabled = 1

                    over "ConvFC_Belt" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Brace_1"
                {
                    over "ConvFC_Brace_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Brace_2"
                {
                    over "ConvFC_Brace_2" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Brace_3"
                {
                    over "ConvFC_Brace_3" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Brace_4"
                {
                    over "ConvFC_Brace_4" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Frame_N"
                {
                    over "ConvFC_Frame_N" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Frame_S"
                {
                    over "ConvFC_Frame_S" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_1N"
                {
                    over "ConvFC_Leg_1N" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_1S"
                {
                    over "ConvFC_Leg_1S" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_2N"
                {
                    over "ConvFC_Leg_2N" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_2S"
                {
                    over "ConvFC_Leg_2S" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_3N"
                {
                    over "ConvFC_Leg_3N" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_3S"
                {
                    over "ConvFC_Leg_3S" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_4N"
                {
                    over "ConvFC_Leg_4N" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }

                over "ConvFC_Leg_4S"
                {
                    over "ConvFC_Leg_4S" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }
            }
        }

        over "_materials"
        {
            over "MAT_FC_BeltAnim"
            {
                def Shader "UVAnim"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/uvmap.outputs:result>
                    float2 inputs:translation = (0, 0)
                    float2 outputs:result
                }

                over "Image_Texture"
                {
                    float2 inputs:st.connect = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/UVAnim.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                }

                over "Image_Texture_001"
                {
                    float2 inputs:st.connect = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/UVAnim.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                }

                over "Image_Texture_002"
                {
                    float2 inputs:st.connect = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/UVAnim.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                }
            }
        }
    }

    def OmniGraph "ConveyorBeltGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        custom float graph:variable:Velocity = 0 (
            customData = {
                string scope = "private"
            }
            displayName = "Velocity"
        )
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OnTick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "read_speed"
        {
            custom rel inputs:graph = </Conveyor/ConveyorBeltGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:variableName = "Velocity"
            token node:type = "omni.graph.core.ReadVariable"
            int node:typeVersion = 2
            custom token outputs:value
        }

        def OmniGraphNode "ConveyorNode_01"
        {
            custom float2 inputs:animateDirection = (1, 0)
            custom float inputs:animateScale = 0.5
            custom bool inputs:animateTexture
            custom rel inputs:conveyorPrim = </Conveyor/Mesh/Geom/conveyor_fc/ConvFC_Belt> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom bool inputs:curved = 0
            custom float inputs:delta
            prepend float inputs:delta.connect = </Conveyor/ConveyorBeltGraph/OnTick.outputs:deltaSeconds>
            custom float3 inputs:direction = (1, 0, 0)
            custom bool inputs:enabled
            custom uint inputs:onStep (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:onStep.connect = </Conveyor/ConveyorBeltGraph/OnTick.outputs:tick>
            custom float inputs:velocity
            prepend float inputs:velocity.connect = </Conveyor/ConveyorBeltGraph/read_speed.outputs:value>
            token node:type = "isaacsim.asset.gen.conveyor.IsaacConveyor"
            int node:typeVersion = 1
        }

        def OmniGraphNode "read_belt_uv"
        {
            custom token inputs:name = "inputs:translation"
            custom rel inputs:prim = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/UVAnim> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom bool inputs:usePath = 0
            token node:type = "omni.graph.nodes.ReadPrimAttribute"
            int node:typeVersion = 3
            custom float2 outputs:value
        }

        def OmniGraphNode "uv_dt_f"
        {
            custom double inputs:value
            prepend double inputs:value.connect = </Conveyor/ConveyorBeltGraph/OnTick.outputs:deltaSeconds>
            token node:type = "omni.graph.nodes.ToFloat"
            int node:typeVersion = 1
            custom float outputs:converted
        }

        def OmniGraphNode "uv_delta_x_vel"
        {
            custom float inputs:a
            prepend float inputs:a.connect = </Conveyor/ConveyorBeltGraph/uv_dt_f.outputs:converted>
            custom float inputs:b
            prepend float inputs:b.connect = </Conveyor/ConveyorBeltGraph/read_speed.outputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom float outputs:product
        }

        def OmniGraphNode "uv_scale_const"
        {
            custom float inputs:value = -0.5
            token node:type = "omni.graph.nodes.ConstantFloat"
            int node:typeVersion = 1
        }

        def OmniGraphNode "uv_x_scale"
        {
            custom float inputs:a
            prepend float inputs:a.connect = </Conveyor/ConveyorBeltGraph/uv_delta_x_vel.outputs:product>
            custom float inputs:b
            prepend float inputs:b.connect = </Conveyor/ConveyorBeltGraph/uv_scale_const.inputs:value>
            token node:type = "omni.graph.nodes.Multiply"
            int node:typeVersion = 2
            custom float outputs:product
        }

        def OmniGraphNode "uv_break"
        {
            custom float2 inputs:tuple
            prepend float2 inputs:tuple.connect = </Conveyor/ConveyorBeltGraph/read_belt_uv.outputs:value>
            token node:type = "omni.graph.nodes.BreakVector2"
            int node:typeVersion = 1
            custom float outputs:x
            custom float outputs:y
        }

        def OmniGraphNode "uv_accumulate"
        {
            custom float inputs:a
            prepend float inputs:a.connect = </Conveyor/ConveyorBeltGraph/uv_break.outputs:x>
            custom float inputs:b
            prepend float inputs:b.connect = </Conveyor/ConveyorBeltGraph/uv_x_scale.outputs:product>
            token node:type = "omni.graph.nodes.Add"
            int node:typeVersion = 2
            custom float outputs:sum
        }

        def OmniGraphNode "uv_step_vec"
        {
            custom float inputs:x
            prepend float inputs:x.connect = </Conveyor/ConveyorBeltGraph/uv_accumulate.outputs:sum>
            custom float inputs:y
            prepend float inputs:y.connect = </Conveyor/ConveyorBeltGraph/uv_break.outputs:y>
            token node:type = "omni.graph.nodes.MakeVector2"
            int node:typeVersion = 1
            custom float2 outputs:tuple
        }

        def OmniGraphNode "write_belt_uv"
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Conveyor/ConveyorBeltGraph/OnTick.outputs:tick>
            custom token inputs:name = "inputs:translation"
            custom rel inputs:prim = </Conveyor/Mesh/_materials/MAT_FC_BeltAnim/UVAnim> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom bool inputs:usdWriteBack = 1
            custom bool inputs:usePath = 0
            custom float2 inputs:value
            prepend float2 inputs:value.connect = </Conveyor/ConveyorBeltGraph/uv_step_vec.outputs:tuple>
            token node:type = "omni.graph.nodes.WritePrimAttribute"
            int node:typeVersion = 3
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
        }
    }
    variantSet "Newton" = {
        "Disabled" {

        }
        "Enabled" (
            prepend payload = @./runnables/physics/newton.usd@
        ) {

        }
    }
    variantSet "PhysX" = {
        "Disabled" {

        }
        "Enabled" (
            prepend payload = @./runnables/physics/physx.usd@
        ) {

        }
    }
}

